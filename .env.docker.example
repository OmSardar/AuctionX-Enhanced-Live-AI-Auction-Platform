# ==============================================================================
# AuctionX — Docker Compose Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` in the root directory for Docker Compose:
#   cp .env.docker.example .env
#
# DO NOT commit the actual `.env` file to version control.
# For production Docker deployments (`compose.prod.yaml`), supply production
# environment values through your CI/CD runner or container orchestrator.
# ==============================================================================

# --- Host Published Ports ---
CLIENT_PORT=3000
# Production: Host ingress / reverse-proxy HTTP port
# CLIENT_PORT=80

SERVER_PORT=5000
# Production: Host port or reverse-proxy backend upstream port
# SERVER_PORT=5000

REC_SERVICE_PORT=8000
# Production: Host port or reverse-proxy recommendation upstream port
# REC_SERVICE_PORT=8000

MONGO_PORT=27017
# Production: MongoDB internal only (do not publish host port in production)
# MONGO_PORT=27017

REDIS_PORT=6379
# Production: Redis internal only (do not publish host port in production)
# REDIS_PORT=6379

# --- Environment Mode ---
NODE_ENV=development
# Production: Set in production container environment
# NODE_ENV=production

# --- Database & Cache (Internal Docker Service Hostnames) ---
# Server connects to MongoDB database "Auction-X"
MONGODB_URL=mongodb://mongodb:27017/Auction-X
# Production: MongoDB Atlas cluster URI or production MongoDB service URI (NEEDS_CONFIRMATION)
# MONGODB_URL=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/Auction-X?retryWrites=true&w=majority

# Recommendation service connects to MongoDB and Redis
MONGODB_URI=mongodb://mongodb:27017
# Production: MongoDB Atlas cluster URI without database path (NEEDS_CONFIRMATION)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=Auction-X
# Production: Ensure matching target database name
# MONGODB_DB=Auction-X

# --- Redis Authentication & Cache Configuration ---
# Local Development (compose.yaml): Redis is unauthenticated; REDIS_PASSWORD is not required.
# Production (compose.prod.yaml): REDIS_PASSWORD is strictly required as a 64-character hexadecimal
# string (256-bit entropy). Generate using a secure random generator:
#   openssl rand -hex 32
# Security Notes:
# - DO NOT commit real secrets or production passwords to version control.
# - Environment-based secret delivery passes credentials to the container process environment;
#   it does NOT protect secrets from privileged host administrators (users with root or docker group access).
# Production Compose automatically derives REDIS_URL as: redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Production: Managed Redis connection URL (overrides default internal compose redis if configured)
# REDIS_URL=rediss://default:<redis_password>@<redis_host>:6379

# --- Inter-Service Communication & Authentication ---
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
# Production: Production internal service name or HTTPS URL
# RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000

# Inter-Service Secrets:
# RECOMMENDATION_HMAC_SECRET and INTERNAL_SERVICE_KEY are independent secrets and MUST be generated
# separately. Never reuse values between them or with JWT_SECRET. Both must be shared identically
# between the backend (server) and recommendation-service, and NEVER exposed to browser clients.
# Generate independently using: openssl rand -hex 32

# RECOMMENDATION_HMAC_SECRET: Used exclusively to generate deterministic pseudonymous HMAC-SHA256
# user identifiers for analytics and personalization without storing or exposing raw email PII.
RECOMMENDATION_HMAC_SECRET=
# Production: Required 256-bit cryptographic secret for pseudonymization HMAC
# RECOMMENDATION_HMAC_SECRET=

# INTERNAL_SERVICE_KEY: Shared pre-shared key (PSK) used strictly for backend-to-microservice
# authentication (e.g. authoritative business event telemetry and personalized recommendation retrieval).
INTERNAL_SERVICE_KEY=
# Production: Required internal service authorization PSK
# INTERNAL_SERVICE_KEY=

CLIENT_URL=http://localhost:3000
# Production: Deployed frontend domain (NEEDS_CONFIRMATION)
# CLIENT_URL=https://auctionx.example.com

# --- Nginx Reverse Proxy Upstream (Production Container Architecture) ---
# Runtime backend upstream address for the Nginx container (used by compose.prod.yaml)
BACKEND_UPSTREAM_URL=http://server:5000
# Production Render Private Network:
# BACKEND_UPSTREAM_URL=http://auctionx-server:10000

# --- Frontend Environment Variables (Browser-Facing) ---
# When using Nginx reverse proxy, leave VITE_API_URL empty so browser requests use same-origin relative URLs (/api)
VITE_API_URL=
# Production with split-origin (optional):
# VITE_API_URL=https://api.auctionx.example.com

VITE_RECOMMENDATION_API_URL=
# Production: Leave EMPTY ("") so all recommendation queries and telemetry events route securely
# through the authenticated, rate-limited Express gateway proxy (/api/recommendations and /api/track).
# Only specify a direct URL if an external public reverse proxy explicitly exposes the recommendation microservice.
# VITE_RECOMMENDATION_API_URL=

VITE_RAZORPAY_API_KEY=rzp_test_your_key_id
# Production: Razorpay Live Key ID (Public key only)
# VITE_RAZORPAY_API_KEY=rzp_live_your_live_key_id

# --- Authentication & JWT Secret ---
JWT_SECRET=auctionx_dev_jwt_secret_key_123456789
# Production: 256-bit random cryptographic secret generated with `openssl rand -hex 32`
# JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# --- Razorpay Payment Gateway Credentials (Server-Side) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Production: Razorpay Live Key ID
# RAZORPAY_KEY_ID=rzp_live_your_live_key_id

RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Production: Razorpay Live Key Secret
# RAZORPAY_KEY_SECRET=your_production_live_key_secret

RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Production: Live Webhook Secret from Razorpay Dashboard
# RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# --- Google OAuth 2.0 Credentials (Optional for local development) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Production: Production Google OAuth Client ID
# GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production: Production Google OAuth Client Secret
# GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# --- Email SMTP Service (Optional for OTP and contact forms) ---
EMAIL_USER=your-email@gmail.com
# Production: Production SMTP email address
# EMAIL_USER=notifications@auctionx.example.com

EMAIL_PASS=your-app-specific-password
# Production: Production SMTP password
# EMAIL_PASS=your-production-smtp-password

# --- Cloudinary Media Storage (Optional for product images) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Production: Production Cloudinary cloud name
# CLOUDINARY_CLOUD_NAME=auctionx-prod-cloud

CLOUDINARY_API_KEY=your-api-key
# Production: Production Cloudinary API key
# CLOUDINARY_API_KEY=your-production-cloudinary-api-key

CLOUDINARY_API_SECRET=your-api-secret
# Production: Production Cloudinary API secret
# CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# --- Optional AI Service Keys ---
GOOGLE_API_KEY=your-google-api-key
# Production: Production Google API key
# GOOGLE_API_KEY=your-production-google-api-key

GOOGLE_CSE_ID=your-google-cse-id
# Production: Production Custom Search Engine ID
# GOOGLE_CSE_ID=your-production-google-cse-id

GENERATIVE_API_KEY=your-gemini-api-key
# Production: Production Gemini API key
# GENERATIVE_API_KEY=your-production-gemini-api-key

GEMINI_API_KEY=your-gemini-api-key
# Production: Production Gemini API key
# GEMINI_API_KEY=your-production-gemini-api-key
