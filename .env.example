# ==============================================================================
# AuctionX — Monorepo Root Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` in the root directory for monorepo development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# In production, services run independently (e.g. Render Web Services and Static Sites)
# and receive their environment variables from the platform dashboard.
# ==============================================================================

# ==============================================================================
# Runtime Modes & Ports
# ==============================================================================

# Node environment mode
NODE_ENV=development
# Production: Set in Render service environment
# NODE_ENV=production

# Backend Express server port
PORT=5000
# Production: Assigned dynamically by Render (PORT=10000)
# PORT=10000

# Client development server port
CLIENT_PORT=5173
# Production: Static site served via CDN (no local port binding)
# CLIENT_PORT=

# Recommendation FastAPI service port
REC_SERVICE_PORT=8000
# Production: Assigned dynamically by Render (PORT=10000)
# REC_SERVICE_PORT=10000

# ==============================================================================
# Database & Cache Configurations
# ==============================================================================

# Backend MongoDB connection URI (Mongoose connects with database name included)
MONGODB_URL=mongodb://127.0.0.1:27017/Auction-X
# Production: MongoDB Atlas production connection string (NEEDS_CONFIRMATION)
# MONGODB_URL=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/Auction-X?retryWrites=true&w=majority

# Atlas synchronization source URI (Used by: `npm run seed:atlas` / `syncAtlasToLocal.js`)
ATLAS_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/Auction-X?retryWrites=true&w=majority
# Production: Not required in production runtime
# ATLAS_MONGODB_URI=

# Recommendation service MongoDB host URI (PyMongo connection string)
MONGODB_URI=mongodb://127.0.0.1:27017
# Production: MongoDB Atlas cluster URI without database path (NEEDS_CONFIRMATION)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name (Shared between backend and recommendation service)
MONGODB_DB=Auction-X
# Production: Production database name
# MONGODB_DB=Auction-X

# Redis cache URL (Used by recommendation service)
REDIS_URL=redis://127.0.0.1:6379/0
# Production: Managed Redis connection URL
# REDIS_URL=rediss://default:<redis_password>@<redis_host>:6379

# ==============================================================================
# Service Endpoints & CORS Origins
# ==============================================================================

# Frontend application URL (Used by backend for CORS, cookies, and OAuth redirects)
CLIENT_URL=http://localhost:5173
# Production: Deployed frontend origin without trailing slash (NEEDS_CONFIRMATION)
# CLIENT_URL=https://auctionx-client.onrender.com

# Backend recommendation proxy target
RECOMMENDATION_SERVICE_URL=http://localhost:8000
# Production: Deployed recommendation service URL (NEEDS_CONFIRMATION)
# RECOMMENDATION_SERVICE_URL=https://auctionx-recommendation-service.onrender.com

# Frontend backend API URL (Vite client build-time variable)
# In development: defaults to http://localhost:5000
# In production same-origin deployment (Render Nginx reverse proxy): leave empty "" to use relative /api
# In split-origin deployment (cross-domain): set to public backend URL (e.g. https://auctionx-server.onrender.com)
VITE_API_URL=http://localhost:5000
# Production: Deployed backend web service URL (or empty "" when reverse-proxied through Nginx)
# VITE_API_URL=

# Nginx reverse proxy backend upstream URL (Runtime environment variable for client Docker container)
# Local Docker / Compose: http://server:5000
# Render Private Networking: http://auctionx-server:10000 (or internal host/port)
BACKEND_UPSTREAM_URL=http://127.0.0.1:5000
# Production (Render Web Service): Set in Render dashboard environment variables:
# BACKEND_UPSTREAM_URL=http://auctionx-server:10000

# Frontend recommendation service URL (Vite client build-time variable)
VITE_RECOMMENDATION_API_URL=http://localhost:8000/api
# Production: Deployed recommendation service URL (NEEDS_CONFIRMATION)
# VITE_RECOMMENDATION_API_URL=https://auctionx-recommendation-service.onrender.com/api

# ==============================================================================
# Authentication & JWT Secrets
# ==============================================================================

# 256-bit cryptographic secret for signing and verifying JWT tokens (>= 32 chars)
JWT_SECRET=auctionx_dev_jwt_secret_key_minimum_32_characters_long
# Production: Cryptographically secure 256-bit secret generated via `openssl rand -hex 32`
# JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# ==============================================================================
# Microservice Security Keys (Recommendation Service & Backend)
# ==============================================================================

# HMAC secret for user ID pseudonymization (Must match between backend and recommendation service)
RECOMMENDATION_HMAC_SECRET=auctionx_dev_rec_hmac_secret_minimum_32_characters_long
# Production: Cryptographically secure 256-bit secret generated via `openssl rand -hex 32`
# RECOMMENDATION_HMAC_SECRET=YOUR_PRODUCTION_HMAC_SECRET_MIN_32_CHARS

# Shared internal service key for backend-to-recommendation-service authentication
INTERNAL_SERVICE_KEY=auctionx_dev_internal_service_key_minimum_32_characters_long
# Production: Cryptographically secure secret generated via `openssl rand -hex 32`
# INTERNAL_SERVICE_KEY=YOUR_PRODUCTION_INTERNAL_SERVICE_KEY_MIN_32_CHARS

# ==============================================================================
# Razorpay Payment Gateway Configuration
# ==============================================================================

# Razorpay Key ID (Canonical backend configuration)
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Production: Razorpay Live Key ID
# RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# Razorpay Key Secret (Strictly backend confidential — NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Production: Razorpay Live Key Secret
# RAZORPAY_KEY_SECRET=your_production_live_key_secret

# Razorpay Webhook Secret (HMAC-SHA256 signature verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Production: Live Webhook Secret from Razorpay Dashboard
# RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# Razorpay Public Key ID for Frontend Checkout Modal (Vite client build-time variable)
VITE_RAZORPAY_API_KEY=rzp_test_your_key_id
# Production: Razorpay Live Key ID (Public key only)
# VITE_RAZORPAY_API_KEY=rzp_live_your_live_key_id

# ==============================================================================
# Third-Party Integrations (Optional for Local Development)
# ==============================================================================

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Production: Production Google OAuth Client ID
# GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production: Production Google OAuth Client Secret
# GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Google OAuth Callback URL
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production: Deployed OAuth callback URL
# GOOGLE_CALLBACK_URL=https://auctionx-server.onrender.com/auth/google/callback

# SMTP Email Service
EMAIL_USER=your-email@gmail.com
# Production: Production SMTP email username
# EMAIL_USER=notifications@auctionx.com

EMAIL_PASS=your-app-specific-password
# Production: Production SMTP app password
# EMAIL_PASS=your-production-smtp-password

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Production: Production Cloudinary cloud name
# CLOUDINARY_CLOUD_NAME=auctionx-prod-cloud

CLOUDINARY_API_KEY=your-api-key
# Production: Production Cloudinary API key
# CLOUDINARY_API_KEY=your-production-cloudinary-api-key

CLOUDINARY_API_SECRET=your-api-secret
# Production: Production Cloudinary API secret
# CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# Optional AI & Search Keys
GOOGLE_API_KEY=your-google-api-key
# Production: Production Google API key
# GOOGLE_API_KEY=your-production-google-api-key

GOOGLE_CSE_ID=your-google-cse-id
# Production: Production Custom Search Engine ID
# GOOGLE_CSE_ID=your-production-google-cse-id

GENERATIVE_API_KEY=your-gemini-api-key
# Production: Production Gemini API key
# GENERATIVE_API_KEY=your-production-gemini-api-key

# ==============================================================================
# Avatar Upload & Media Security (Optional Tuning)
# ==============================================================================

# Maximum avatar uploads per 15-minute window per account (default: 10)
# RATE_LIMIT_AVATAR_MAX=10

# Initial exponential backoff delay in ms for Cloudinary rollback retries (default: 500)
# CLOUDINARY_RETRY_DELAY_MS=500
