# ==============================================================================
# AuctionX — Client (Frontend) Environment Configuration Example
# ==============================================================================
# Copy this file to `client/.env.local` or `client/.env` for local development:
#   cp .env.example .env.local
#
# Vite exposes variables prefixed with `VITE_` to the browser bundle at build time.
# NEVER place sensitive server secrets (API secrets, private keys) in this file.
#
# Production hosting: Configured as a Render static site (`auctionx-client`) or Vercel.
# Production values are injected at build time by the hosting platform.
# ==============================================================================

# Backend API base URL
# Local Development: Defaults to empty or http://localhost:5000. When left empty, Vite dev server
# proxies /api, /socket.io, and /auth directly to http://localhost:5000.
# Production (Render Nginx Web Service / Docker Compose): Leave EMPTY ("") so all browser
# requests use same-origin relative URLs (/api), eliminating cross-site cookie restrictions.
# Nginx forwards these requests to the backend upstream over Render private networking.
VITE_API_URL=
# Production Split-Origin (Optional fallback only if not using reverse proxy):
# VITE_API_URL=https://auctionx-enhanced-live-server.onrender.com

# Recommendation service API base URL (Leave empty in production to route through Express gateway)
VITE_RECOMMENDATION_API_URL=http://localhost:8000/api
# Production: Leave empty so recommendations route through Express backend proxy (Recommended)
# VITE_RECOMMENDATION_API_URL=

# Razorpay public Key ID (Browser checkout modal — public key only)
VITE_RAZORPAY_API_KEY=rzp_test_your_key_id
# Production: Replace with your Razorpay Live Key ID (rzp_live_...)
# VITE_RAZORPAY_API_KEY=rzp_live_your_live_key_id
