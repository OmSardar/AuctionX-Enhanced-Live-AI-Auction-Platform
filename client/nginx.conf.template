# ==============================================================================
# AuctionX — Nginx Same-Origin Reverse Proxy Template
# ==============================================================================
# Evaluated at container startup by /docker-entrypoint.sh using envsubst.
# Proxies browser requests to the backend over Render private networking or Docker bridge.

# Map WebSocket upgrade header for Socket.IO real-time bidding
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Preserve inbound X-Forwarded-Proto from TLS termination proxy, defaulting to $scheme
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    server_name localhost;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Maximum payload size (aligned with Express JSON 10mb limit and multer 5mb limit)
    client_max_body_size 10M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Baseline security headers for static responses
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Dedicated non-sensitive Health Check endpoint for Render & container orchestrators
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # ==========================================================================
    # API Reverse Proxy — forwards all /api/ requests to the backend upstream
    # ==========================================================================
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM_URL};
        proxy_http_version 1.1;

        # Identity and protocol forwarding
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts consistent with backend operations
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        # Buffer sizing for API JSON & headers
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;

        # Disable caching on API responses & Set-Cookie headers
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # ==========================================================================
    # Real-Time Socket.IO Proxy — WebSockets & Long-Polling for Live Bidding
    # ==========================================================================
    location /socket.io/ {
        proxy_pass ${BACKEND_UPSTREAM_URL};
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Client identity headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Long-lived WebSocket connection timeouts (24 hours)
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Disable buffering for instant message delivery
        proxy_buffering off;
    }

    # ==========================================================================
    # Authentication Proxy — OAuth / Social Login routes (e.g. /auth/google)
    # ==========================================================================
    location /auth/ {
        proxy_pass ${BACKEND_UPSTREAM_URL};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Static Assets Caching — Immutable cache for fingerprinted Vite assets
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Disable access logs for favicon and robots
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        log_not_found off;
        access_log off;
    }

    # Single Page Application (SPA) fallback routing
    # Never cache index.html so clients immediately receive new bundle hashes on deploy
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
