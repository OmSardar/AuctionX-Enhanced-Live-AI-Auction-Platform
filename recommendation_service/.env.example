# ==============================================================================
# AuctionX — Recommendation Service (FastAPI) Environment Configuration Example
# ==============================================================================
# Copy this file to `recommendation_service/.env` for local development:
#   cp .env.example .env
#
# DO NOT commit real database passwords or production credentials to version control.
# In production on Render (`auctionx-recommendation-service`), configure these
# environment variables in the Render Dashboard service environment.
# ==============================================================================

# Runtime environment (development | production | test)
ENVIRONMENT=development
# Production: Set in Render service environment
# ENVIRONMENT=production

# HTTP listener port
PORT=8000
# Production: Render automatically assigns PORT (typically 10000)
# PORT=10000

# MongoDB host / cluster connection URI (PyMongo connects to this URI)
MONGODB_URI=mongodb://127.0.0.1:27017
# Production: MongoDB Atlas cluster URI without database path (NEEDS_CONFIRMATION)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name (Shared with backend API for user interactions and items)
MONGODB_DB=Auction-X
# Production: Ensure this matches the backend target database name
# MONGODB_DB=Auction-X

# Redis cache URL (Optional: graceful in-memory fallback if Redis is unavailable)
REDIS_URL=redis://127.0.0.1:6379/0
# Production: Managed Redis URL (e.g., Redis Cloud or Render Redis)
# REDIS_URL=rediss://default:<redis_password>@<redis_host>:6379

# Primary client frontend URL for CORS access
CLIENT_URL=http://localhost:5173
# Production: Deployed frontend origin (NEEDS_CONFIRMATION)
# CLIENT_URL=https://auctionx-client.onrender.com

# Additional allowed CORS origins (Comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: Comma-separated list of deployed frontend origins (NEEDS_CONFIRMATION)
# ALLOWED_ORIGINS=https://auctionx-client.onrender.com,https://auctionx.vercel.app

# ==============================================================================
# Microservice Security Keys (Shared with Backend)
# ==============================================================================

# HMAC secret for user ID pseudonymization (Must match backend RECOMMENDATION_HMAC_SECRET)
RECOMMENDATION_HMAC_SECRET=auctionx_dev_rec_hmac_secret_minimum_32_characters_long
# Production: Set in Render service environment
# RECOMMENDATION_HMAC_SECRET=YOUR_PRODUCTION_HMAC_SECRET_MIN_32_CHARS

# Shared internal service key for backend-to-recommendation-service authentication
INTERNAL_SERVICE_KEY=auctionx_dev_internal_service_key_minimum_32_characters_long
# Production: Set in Render service environment
# INTERNAL_SERVICE_KEY=YOUR_PRODUCTION_INTERNAL_SERVICE_KEY_MIN_32_CHARS
