# ==============================================================================
# AuctionX — Backend Server (Node.js/Express) Environment Configuration Example
# ==============================================================================
# Copy this file to `server/.env` for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# In production on Render (`auctionx-server`), configure sensitive variables
# in the Render Dashboard service environment settings.
# ==============================================================================

# Runtime environment (development | production | test)
NODE_ENV=development
# Production: Set in Render service environment
# NODE_ENV=production

# HTTP listener port
PORT=5000
# Production: Render automatically sets PORT (typically 10000)
# PORT=10000

# 256-bit cryptographic secret for signing and verifying JWT authentication tokens (>= 32 chars)
JWT_SECRET=auctionx_dev_jwt_secret_key_minimum_32_characters_long
# Production: Generate with `openssl rand -hex 32` and set in Render environment
# JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# Prometheus metrics scrape bearer authentication token (Required in production)
METRICS_AUTH_TOKEN=auctionx_dev_metrics_token_example_12345
# Production: Required in production (`NODE_ENV=production`) to prevent unauthenticated access to /metrics
# METRICS_AUTH_TOKEN=YOUR_PRODUCTION_METRICS_AUTH_TOKEN_MIN_32_CHARS


# MongoDB connection string with target database name included
MONGODB_URL=mongodb://127.0.0.1:27017/Auction-X
# Production: MongoDB Atlas connection string (NEEDS_CONFIRMATION)
# MONGODB_URL=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/Auction-X?retryWrites=true&w=majority

# Atlas synchronization source URI (Used by: `npm run seed:atlas` / `syncAtlasToLocal.js`)
ATLAS_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/Auction-X?retryWrites=true&w=majority
# Production: Not required in production runtime
# ATLAS_MONGODB_URI=

# Client frontend URL (Used for CORS, auth cookies, and Google OAuth redirects)
CLIENT_URL=http://localhost:3000
# Production: Deployed frontend origin without trailing slash (e.g. Vercel or Render)
# CLIENT_URL=https://auction-x-enhanced-live-ai-auction.vercel.app
# Comma-separated additional allowed CORS origins (Optional)
# ALLOWED_ORIGINS=https://auction-x-enhanced-live-ai-auction.vercel.app,https://auctionx-client.onrender.com

# Recommendation service base URL
RECOMMENDATION_SERVICE_URL=http://localhost:8000
# Production: Deployed recommendation service URL (NEEDS_CONFIRMATION)
# RECOMMENDATION_SERVICE_URL=https://auctionx-recommendation-service.onrender.com

# HMAC secret for recommendation telemetry pseudonymization (Must match recommendation service)
RECOMMENDATION_HMAC_SECRET=auctionx_dev_rec_hmac_secret_minimum_32_characters_long
# Production: Generate with `openssl rand -hex 32` and set in Render environment
# RECOMMENDATION_HMAC_SECRET=YOUR_PRODUCTION_HMAC_SECRET_MIN_32_CHARS

# Shared internal service key for backend-to-recommendation-service communication
INTERNAL_SERVICE_KEY=auctionx_dev_internal_service_key_minimum_32_characters_long
# Production: Generate with `openssl rand -hex 32` and set in Render environment
# INTERNAL_SERVICE_KEY=YOUR_PRODUCTION_INTERNAL_SERVICE_KEY_MIN_32_CHARS

# ==============================================================================
# Payment Gateway Configuration (Razorpay - Canonical Backend Keys)
# ==============================================================================

# Razorpay Key ID
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Production: Razorpay Live Key ID
# RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# Razorpay Key Secret (Server-side only — NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Production: Razorpay Live Key Secret
# RAZORPAY_KEY_SECRET=your_production_live_key_secret

# Razorpay Webhook Secret (Used for HMAC signature verification of webhook events)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Production: Configured in Razorpay Dashboard for live webhook endpoint
# RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# ==============================================================================
# Third-Party Integrations & Services (Optional for Local Development)
# ==============================================================================

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Production: Set registered production Google OAuth Client ID
# GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production: Set registered production Google OAuth Client Secret
# GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Google OAuth Callback URL (Defaults to /auth/google/callback if unset)
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production: Deployed callback URL matching Google Cloud Console authorized redirect URIs
# GOOGLE_CALLBACK_URL=https://auctionx-server.onrender.com/auth/google/callback

# ==============================================================================
# Email Delivery Configuration (Centralized dual-provider: SMTP vs Resend)
# ==============================================================================

# Active email provider: 'smtp' (local development) | 'resend' (production on Render)
EMAIL_PROVIDER=smtp
# Production on Render: Outbound SMTP ports (25, 465, 587) are restricted. Set to 'resend':
# EMAIL_PROVIDER=resend

# Resend HTTPS API Key (Required when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Identity (Defaults to: AuctionX <notifications@mail.omslabs.tech>)
EMAIL_FROM="AuctionX <notifications@mail.omslabs.tech>"

# Optional Reply-To address (e.g. your Gmail support address)
EMAIL_REPLY_TO=support@mail.omslabs.tech

# Local SMTP Email credentials (Used when EMAIL_PROVIDER=smtp)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Cloudinary media storage (Product image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Production: Set production Cloudinary cloud name
# CLOUDINARY_CLOUD_NAME=auctionx-prod-cloud

CLOUDINARY_API_KEY=your-api-key
# Production: Set production Cloudinary API key
# CLOUDINARY_API_KEY=your-production-cloudinary-api-key

CLOUDINARY_API_SECRET=your-api-secret
# Production: Set production Cloudinary API secret
# CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# ==============================================================================
# AI & Search Services (Optional)
# ==============================================================================

# Google Custom Search API Key
GOOGLE_API_KEY=your-google-api-key
# Production: Production Google API key
# GOOGLE_API_KEY=your-production-google-api-key

# Google Custom Search Engine ID
GOOGLE_CSE_ID=your-google-cse-id
# Production: Production Custom Search Engine ID
# GOOGLE_CSE_ID=your-production-google-cse-id

# Google Gemini Generative AI Key
GENERATIVE_API_KEY=your-gemini-api-key
# Production: Production Gemini API key
# GENERATIVE_API_KEY=your-production-gemini-api-key

# ==============================================================================
# Lifecycle Scheduler Tuning (Optional)
# ==============================================================================

# Auction lifecycle scheduler evaluation interval in milliseconds (default: 5000)
SCHEDULER_INTERVAL_MS=5000
# Production: Default 5000 ms (Keep single backend replica in staging/production)
# SCHEDULER_INTERVAL_MS=5000

# Batch size for expired auction processing (default: 50)
SCHEDULER_BATCH_SIZE=50
# Production: Default 50
# SCHEDULER_BATCH_SIZE=50

# ==============================================================================
# Avatar Upload & Media Security (Optional Tuning)
# ==============================================================================

# Maximum avatar uploads per 15-minute window per account (default: 10)
# RATE_LIMIT_AVATAR_MAX=10

# Initial exponential backoff delay in ms for Cloudinary rollback retries (default: 500)
# CLOUDINARY_RETRY_DELAY_MS=500
