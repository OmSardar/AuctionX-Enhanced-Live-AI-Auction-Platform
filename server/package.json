{
  "name": "server",
  "version": "1.0.0",
  "description": "AuctionX Backend",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit",
    "test:smoke": "jest tests/smoke --runInBand --detectOpenHandles --forceExit",
    "test:acceptance": "jest tests/acceptance --runInBand --detectOpenHandles --forceExit",
    "test:perf": "jest tests/performance --testPathIgnorePatterns=/node_modules/ --runInBand --detectOpenHandles --forceExit --testTimeout=60000",
    "test:load": "jest tests/load --testPathIgnorePatterns=/node_modules/ --runInBand --detectOpenHandles --forceExit --testTimeout=120000",
    "test:nonfunctional": "jest tests/nonfunctional --runInBand --detectOpenHandles --forceExit",
    "test:blackbox": "jest tests/blackbox --runInBand --detectOpenHandles --forceExit",
    "test:graybox": "jest tests/graybox --runInBand --detectOpenHandles --forceExit",
    "test:all": "jest --testPathIgnorePatterns=/node_modules/ --runInBand --detectOpenHandles --forceExit --testTimeout=120000",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:atlas": "node scripts/data/syncAtlasToLocal.js",
    "seed:demo": "node scripts/data/seedDemoData.js",
    "seed:demo:clear": "node scripts/data/seedDemoData.js --clear",
    "seed:demo:catalogue": "node scripts/data/seedDemoCatalogue.js",
    "seed:demo:auctions": "node scripts/data/seedLiveDemoAuctions.js",
    "seed:demo:wallet": "node scripts/data/seedWalletDemoAuctions.js",
    "admin:bootstrap": "node scripts/administration/bootstrapAdmin.js",
    "dr:verify": "node scripts/backup/backupAndRecoveryVerify.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Om Sardar",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^9.14.2",
    "graphql": "^16.14.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
